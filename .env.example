# Copy to .env (gitignored). Keys are never inferred into strategy choice.
# Set only the provider you selected in configs (llm.default_provider / dense_embedder.name).

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Optional. Hugging Face Hub token. Raises anonymous download rate limits.
HF_TOKEN=

# Optional default profile for the CLI when --profile is omitted.
DOCINTEL_PROFILE=dev_cpu
